{
    "manifest_version": 2.0,
    "id": "kmansur_zabbix_template_update_manager",
    "name": "Template Update Manager",
    "namespace": "ZabbixTemplateUpdateManager",
    "version": "0.1.0-beta.50",
    "author": "Karim Mansur",
    "description": "Discover, install, compare and safely manage official Zabbix templates.",
    "actions": {
        "ztum.templates": {
            "class": "TemplateList",
            "view": "ztum.template.list"
        },
        "ztum.templates.prepare_selected": {
            "class": "TemplateBatchPrepare",
            "view": "ztum.template.batch.prepare"
        },
        "ztum.templates.prepare_one": {
            "class": "TemplateBatchPrepareOne",
            "layout": "layout.json",
            "view": null
        },
        "ztum.templates.batch_update_one": {
            "class": "TemplateBatchUpdateOne",
            "layout": "layout.json",
            "view": null
        },
        "ztum.templates.batch_update": {
            "class": "TemplateBatchUpdate",
            "view": "ztum.template.batch.update"
        },
        "ztum.templates.install_prepare_selected": {
            "class": "TemplateInstallBatchPrepare",
            "view": "ztum.template.install.batch.prepare"
        },
        "ztum.templates.install_prepare_one": {
            "class": "TemplateInstallBatchPrepareOne",
            "layout": "layout.json",
            "view": null
        },
        "ztum.templates.install_execute_one": {
            "class": "TemplateInstallBatchExecuteOne",
            "layout": "layout.json",
            "view": null
        },
        "ztum.template.install.review": {
            "class": "TemplateInstallReview",
            "view": "ztum.template.install.review"
        },
        "ztum.template.install": {
            "class": "TemplateInstall",
            "view": "ztum.template.install"
        },
        "ztum.template.compare": {
            "class": "TemplateCompare",
            "view": "ztum.template.compare"
        },
        "ztum.template.backup": {
            "class": "TemplateBackup"
        },
        "ztum.template.backups": {
            "class": "TemplateBackupList",
            "view": "ztum.template.backup.list"
        },
        "ztum.template.preflight": {
            "class": "TemplatePreflight",
            "view": "ztum.template.preflight"
        },
        "ztum.template.update": {
            "class": "TemplateUpdate",
            "view": "ztum.template.update"
        },
        "ztum.template.rollback.review": {
            "class": "TemplateRollbackReview",
            "view": "ztum.template.rollback.review"
        },
        "ztum.template.rollback": {
            "class": "TemplateRollback",
            "view": "ztum.template.rollback"
        }
    }
}
